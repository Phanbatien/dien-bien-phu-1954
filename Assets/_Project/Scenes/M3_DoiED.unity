MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1720178405}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fa598ddb2a23b814d86cf6ee8d84dc39, type: 3}
  m_Name: 
  m_EditorClassIdentifier: DBP.Runtime::DBP.Missions.RadioChatter
  lines:
  - "[V\xF4 tuy\u1EBFn] S\u1EDF ch\u1EC9 huy g\u1ECDi \u0110\u1EA1i \u0111\u1ED9i
    1: ph\xE1o ta \u0111ang b\u1EAFn chu\u1EA9n b\u1ECB v\xE0o \u0111\u1ED3i E, D.
    Ch\u1EDD ph\xE1o d\u1EE9t th\xEC xung phong. H\u1EBFt."
  - "[V\xF4 tuy\u1EBFn] M\u0169i xung k\xEDch \u0111\xE3 \xE1p s\xE1t h\xE0ng r\xE0o.
    Ph\xE1o s\xE1ng \u0111\u1ECBch l\xEAn th\xEC n\u1EB1m im, t\u1EAFt s\xE1ng m\u1EDBi
    ti\u1EBFn. H\u1EBFt."
  - "[V\xF4 tuy\u1EBFn] \u0110\u1ED3i D1 \u0111\xE3 c\u1EAFm c\u1EDD! C\xE1c m\u0169i
    ti\u1EBFp t\u1EE5c \u0111\xE1nh v\xE0o trung t\xE2m c\u1EE9 \u0111i\u1EC3m. H\u1EBFt."
  - "[V\xF4 tuy\u1EBFn] \u0110\u1ECBch b\u1EAFn ph\xE1o ch\u1EB7n v\xE0 chu\u1EA9n
    b\u1ECB ph\u1EA3n k\xEDch. \u0110\xE0o h\u1EA7m c\xE1 nh\xE2n, gi\u1EEF ch\u1EAFc
    tr\u1EADn \u0111\u1ECBa v\u1EEBa chi\u1EBFm. H\u1EBFt."
  - "[V\xF4 tuy\u1EBFn] T\u1ED1t l\u1EAFm, c\xE1c \u0111\u1ED3ng ch\xED! Gi\u1EEF
    ch\u1ED1t \u0111\u1EBFn s\xE1ng, ch\u1EDD l\u1EC7nh m\u1EDBi. H\u1EBFt."
  firstDelay: 4
